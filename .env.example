# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# Port the API server runs on
PORT=5000

# MongoDB connection string.
# Get a free one from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vitaline
MONGO_URI=your_mongodb_connection_string_here

# Any long random string — used to sign login tokens.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_secret_here

# development | production
NODE_ENV=development
